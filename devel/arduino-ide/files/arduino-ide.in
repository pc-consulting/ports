#!/bin/sh

PATH="%%PREFIX%%/bin:${PATH}:%%LLVM_PREFIX%%/bin"
export PATH

if [ -z "${DBUS_SESSION_BUS_ADDRESS}" ]; then
    export DBUS_SESSION_BUS_ADDRESS="autolaunch:"
fi

_ide_data_dir="${HOME}/.arduinoIDE"
_cli_config="${_ide_data_dir}/arduino-cli.yaml"
mkdir -p "${_ide_data_dir}"

if [ ! -f "${_cli_config}" ]; then
    printf 'board_manager:\n  additional_urls: []\ndirectories:\n  data: %s\n  user: %s\n' \
        "${_ide_data_dir}" "${HOME}/Arduino" > "${_cli_config}"
elif ! grep -q '^directories:' "${_cli_config}"; then
    printf 'directories:\n  data: %s\n  user: %s\n' \
        "${_ide_data_dir}" "${HOME}/Arduino" >> "${_cli_config}"
fi

# Arduino's own package_index.json has no FreeBSD tool releases for any
# platform. Rather than let arduino-cli try (and fail) to download them,
# pre-populate the exact versioned tool/hardware paths it expects, backed by
# the FreeBSD ports named in this port's RUN_DEPENDS. See pkg-message(1).

_populate_builtin_tool() {
    _name="$1"; _version="$2"; _binpath="$3"
    _dst="${_ide_data_dir}/packages/builtin/tools/${_name}/${_version}"
    if [ -x "${_binpath}" ] && [ ! -e "${_dst}/${_name}" ]; then
        mkdir -p "${_dst}"
        ln -sf "${_binpath}" "${_dst}/${_name}"
    fi
}
_populate_builtin_tool ctags 5.8-arduino11 "%%LOCALBASE%%/arduino/tools-builder/ctags/5.8-arduino11/ctags"
_populate_builtin_tool dfu-discovery 0.1.2 "%%LOCALBASE%%/bin/arduino-dfu-discovery"
_populate_builtin_tool mdns-discovery 1.1.0 "%%LOCALBASE%%/bin/arduino-mdns-discovery"
_populate_builtin_tool serial-discovery 1.5.2 "%%LOCALBASE%%/bin/arduino-serial-discovery"
_populate_builtin_tool serial-monitor 0.15.0 "%%LOCALBASE%%/bin/arduino-serial-monitor"

# Whole-prefix tools (compiler/programmer toolchains): the version string
# below is NOT a real upstream Arduino toolchain release -- it is only the
# exact string this board platform's platform.txt requires, so arduino-cli's
# tool lookup is satisfied. The real binaries always come from FreeBSD's own
# avr-gcc/avr-libc/avrdude packages, whatever version pkg(8) currently has
# installed -- follow the "freebsd-port-provided" link, not the version
# string, to see what is actually in use.
_populate_platform_tool() {
    _vendor="$1"; _name="$2"; _version="$3"; _target="$4"
    _dir="${_ide_data_dir}/packages/${_vendor}/tools/${_name}"
    if [ -d "${_target}" ] && [ ! -e "${_dir}/${_version}" ]; then
        mkdir -p "${_dir}"
        ln -sf "${_target}" "${_dir}/freebsd-port-provided"
        ln -sf "freebsd-port-provided" "${_dir}/${_version}"
    fi
}
_populate_platform_tool arduino avr-gcc 7.3.0-atmel3.6.1-arduino7 "%%LOCALBASE%%"
_populate_platform_tool arduino avrdude 6.3.0-arduino17 "%%LOCALBASE%%"
_populate_platform_tool arduino xtensa-esp32-elf-gcc 3.0.0 "%%LOCALBASE%%/xtensa-esp-elf"
_populate_platform_tool esp32 esp-x32 2405 "%%LOCALBASE%%/xtensa-esp-elf"
_populate_platform_tool esp32 esptool_py 4.9.dev3 "%%LOCALBASE%%/bin/esptool"

_populate_platform_hardware() {
    _vendor="$1"; _arch="$2"; _version="$3"; _srcdir="$4"
    _dst="${_ide_data_dir}/packages/${_vendor}/hardware/${_arch}"
    if [ -d "${_srcdir}" ] && [ ! -e "${_dst}/${_version}" ]; then
        mkdir -p "${_dst}"
        ln -sf "${_srcdir}" "${_dst}/${_version}"
    fi
}
_populate_platform_hardware arduino avr 1.8.6 "%%PREFIX%%/share/arduino-ide/hardware/avr-1.8.6"
_populate_platform_hardware esp32 esp32 3.1.3 "%%PREFIX%%/share/arduino-ide/hardware/esp32-3.1.3"

exec "%%PREFIX%%/bin/electron%%ELECTRON_VER_MAJOR%%" \
    "%%DATADIR%%/resources/app" "$@"
