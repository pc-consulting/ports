+pub fn list_devices() -> impl MaybeFuture<Output = Result<impl Iterator<Item = DeviceInfo>, Error>> {
+    Ready((|| {
+        let ctx = context()?;
+        let mut list = ptr::null_mut();
+        let n = unsafe { libusb_get_device_list(ctx, &mut list) };
+        if n < 0 {
+            return Err(error(n as i32, "failed to enumerate USB devices"));
+        }
+
+        let mut devices = Vec::new();
+        for i in 0..n as usize {
+            let dev = unsafe { *list.add(i) };
+            let mut desc = LibusbDeviceDescriptor::default();
+            if unsafe { libusb_get_device_descriptor(dev, &mut desc) } != SUCCESS {
+                continue;
+            }
+
+            let busnum = unsafe { libusb_get_bus_number(dev) };
+            let address = unsafe { libusb_get_device_address(dev) };
+            let mut port_chain = [0u8; 8];
+            let port_count = unsafe {
+                libusb_get_port_numbers(dev, port_chain.as_mut_ptr(), port_chain.len() as u8)
+            };
+            let port_chain = if port_count > 0 {
+                port_chain[..port_count as usize].to_vec()
+            } else {
+                Vec::new()
+            };
+
+            let mut interfaces = Vec::new();
+            let mut configs = Vec::new();
+            let mut handle = ptr::null_mut();
+
+            if unsafe { libusb_open(dev, &mut handle) } == SUCCESS {
+                configs = collect_config_descriptors(
+                    handle,
+                    desc.b_num_configurations,
+                );
+
+                let mut buf = [0u8; 256];
+                let manufacturer_string = if desc.i_manufacturer != 0 {
+                    string_descriptor(handle, desc.i_manufacturer, &mut buf)
+                } else {
+                    None
+                };
+                let product_string = if desc.i_product != 0 {
+                    string_descriptor(handle, desc.i_product, &mut buf)
+                } else {
+                    None
+                };
+                let serial_number = if desc.i_serial_number != 0 {
+                    string_descriptor(handle, desc.i_serial_number, &mut buf)
+                } else {
+                    None
+                };
+
+                unsafe { libusb_close(handle) };
+
+                for raw in &configs {
+                    parse_interfaces(raw, &mut interfaces);
+                }
+
+                devices.push(DeviceInfo {
+                    busnum,
+                    bus_id: format!("{busnum:03}"),
+                    device_address: address,
+                    port_chain,
+                    vendor_id: desc.id_vendor,
+                    product_id: desc.id_product,
+                    device_version: desc.bcd_device,
+                    usb_version: desc.bcd_usb,
+                    class: desc.b_device_class,
+                    subclass: desc.b_device_sub_class,
+                    protocol: desc.b_device_protocol,
+                    speed: match unsafe { libusb_get_device_speed(dev) } {
+                        1 => Some(Speed::Low),
+                        2 => Some(Speed::Full),
+                        3 => Some(Speed::High),
+                        4 => Some(Speed::Super),
+                        5 => Some(Speed::SuperPlus),
+                        _ => None,
+                    },
+                    manufacturer_string,
+                    product_string,
+                    serial_number,
+                    interfaces,
+
+                });
+            } else {
+                devices.push(DeviceInfo {
+                    busnum,
+                    bus_id: format!("{busnum:03}"),
+                    device_address: address,
+                    port_chain,
+                    vendor_id: desc.id_vendor,
+                    product_id: desc.id_product,
+                    device_version: desc.bcd_device,
+                    usb_version: desc.bcd_usb,
+                    class: desc.b_device_class,
+                    subclass: desc.b_device_sub_class,
+                    protocol: desc.b_device_protocol,
+                    speed: match unsafe { libusb_get_device_speed(dev) } {
+                        1 => Some(Speed::Low),
+                        2 => Some(Speed::Full),
+                        3 => Some(Speed::High),
+                        4 => Some(Speed::Super),
+                        5 => Some(Speed::SuperPlus),
+                        _ => None,
+                    },
+                    manufacturer_string: None,
+                    product_string: None,
+                    serial_number: None,
+                    interfaces,
+                });
+            }
+        }
+
+        unsafe { libusb_free_device_list(list, 1) };
+        Ok(devices.into_iter())
+    })())
+}
