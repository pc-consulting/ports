+pub struct Endpoint {
+    inner: Arc<EndpointInner>,
+    pub(crate) max_packet_size: usize,
+    pending: VecDeque<Pending<TransferData>>,
+}
+
+struct EndpointInner {
+    interface: Arc<Interface>,
+    address: u8,
+    ep_type: TransferType,
+    notify: Arc<Notify>,
+}
+
+impl Endpoint {
+    pub(crate) fn endpoint_address(&self) -> u8 { self.inner.address }
+    pub(crate) fn pending(&self) -> usize { self.pending.len() }
+    pub(crate) fn cancel_all(&mut self) {
+        // Synchronous libusb transfers are executed on worker threads. They
+        // cannot be cancelled through this backend; dropping Pending marks the
+        // transfer abandoned and the worker completes it safely.
+        while self.pending.first().is_some_and(|p| p.is_complete()) {
+            let _ = self.pending.pop_front();
+        }
+    }
+    pub(crate) fn allocate(&self, len: usize) -> Result<Buffer, std::io::Error> {
+        Ok(Buffer::new(len))
+    }
+    pub(crate) fn submit_err(&mut self, data: Buffer, _error: TransferError) {
+        self.submit(data);
+    }
+
+    fn start(&self, idle: crate::transfer::internal::Idle<TransferData>) -> Pending<TransferData> {
+        let raw = idle.as_ptr();
+        let pending = idle.pre_submit();
+        let handle = self.inner.interface.device.inner.handle;
+        let ep = self.inner.address;
+        let ty = self.inner.ep_type;
+        let notify = self.inner.notify.clone();
+
+        std::thread::spawn(move || {
+            let td = unsafe { &mut *raw };
+            let mut transferred = 0i32;
+            let rc = unsafe {
+                match ty {
+                    TransferType::Bulk => libusb_bulk_transfer(
+                        handle, ep, td.ptr, td.length as i32, &mut transferred, 1000,
+                    ),
+                    TransferType::Interrupt => libusb_interrupt_transfer(
+                        handle, ep, td.ptr, td.length as i32, &mut transferred, 1000,
+                    ),
+                    TransferType::Isochronous => ERROR_NOT_SUPPORTED,
+                    TransferType::Control => ERROR_INVALID_PARAM,
+                }
+            };
+            td.actual = transferred.max(0) as u32;
+            td.status = if rc == SUCCESS { 0 } else { rc };
+            unsafe { crate::transfer::internal::notify_completion(raw) };
+            notify.notify();
+        });
+        pending
+    }
+
+    pub(crate) fn submit(&mut self, data: Buffer) {
+        let mut td = TransferData::new(self.inner.address, self.inner.ep_type);
+        td.set_buffer(data);
+        let idle = crate::transfer::internal::Idle::new(self.inner.notify.clone(), td);
+        self.pending.push_back(self.start(idle));
+    }
+
+    pub(crate) fn poll_next_complete(
+        &mut self,
+        cx: &mut Context,
+    ) -> Poll<Completion> {
+        self.inner.notify.subscribe(cx);
+        if let Some(p) = self.pending.front() {
+            if p.is_complete() {
+                let p = self.pending.pop_front().unwrap();
+                let mut idle = unsafe { p.into_idle() };
+                return Poll::Ready(idle.take_completion());
+            }
+        }
+        Poll::Pending
+    }
+
+    pub(crate) fn wait_next_complete(
+        &mut self,
+        timeout: Duration,
+    ) -> Option<Completion> {
+        self.inner.notify.wait_timeout(timeout, || {
+            if self.pending.front().is_some_and(|p| p.is_complete()) {
+                let p = self.pending.pop_front().unwrap();
+                let mut idle = unsafe { p.into_idle() };
+                Some(idle.take_completion())
+            } else {
+                None
+            }
+        })
+    }
+
+    pub(crate) fn clear_halt(&self) -> impl MaybeFuture<Output = Result<(), Error>> {
+        let rc = unsafe {
+            libusb_clear_halt(self.inner.interface.device.inner.handle, self.inner.address)
+        };
+        Ready(if rc == SUCCESS {
+            Ok(())
+        } else {
+            Err(error(rc, "failed to clear halt"))
+        })
+    }
+}
+
+struct TransferData {
+    ptr: *mut u8,
+    length: u32,
+    capacity: u32,
+    requested: u32,
+    allocator: Allocator,
+    actual: u32,
+    status: i32,
+    endpoint: u8,
+}
+unsafe impl Send for TransferData {}
+unsafe impl Sync for TransferData {}
+
+impl TransferData {
+    fn new(endpoint: u8, _ty: TransferType) -> Self {
+        Self {
+            ptr: ptr::null_mut(),
+            length: 0,
+            capacity: 0,
+            requested: 0,
+            allocator: Allocator::Default,
+            actual: 0,
+            status: 0,
+            endpoint,
+        }
+    }
+
+    fn new_control_in(d: ControlIn) -> Self {
+        let mut t = Self::new(0x80, TransferType::Control);
+        let mut b = Buffer::new(8 + d.length as usize);
+        b.extend_from_slice(&d.setup_packet());
+        t.set_buffer(b);
+        t
+    }
+
+    fn new_control_out(d: ControlOut) -> Self {
+        let mut t = Self::new(0, TransferType::Control);
+        let mut b = Buffer::new(8 + d.data.len());
+        b.extend_from_slice(&d.setup_packet());
+        b.extend_from_slice(d.data);
+        t.set_buffer(b);
+        t
+    }
+
+    fn set_buffer(&mut self, b: Buffer) {
+        let b = std::mem::ManuallyDrop::new(b);
+        self.ptr = b.ptr;
+        self.capacity = b.capacity;
+        self.requested = b.requested_len;
+        self.length = if Direction::from_address(self.endpoint) == Direction::In {
+            b.requested_len
+        } else {
+            b.len
+        };
+        self.allocator = b.allocator;
+    }
+
+    fn status(&self) -> Result<(), TransferError> {
+        if self.status == 0 {
+            Ok(())
+        } else {
+            Err(transfer_error(self.status))
+        }
+    }
+
+    fn control_data(&self) -> &[u8] {
+        unsafe { std::slice::from_raw_parts(self.ptr.add(8), self.actual as usize) }
+    }
+
+    fn take_completion(&mut self) -> Completion {
+        let len = if Direction::from_address(self.endpoint) == Direction::In {
+            self.actual
+        } else {
+            self.length
+        };
+        let ptr = self.ptr;
+        let cap = self.capacity;
+        let req = self.requested;
+        self.ptr = ptr::null_mut();
+        self.capacity = 0;
+        Completion {
+            buffer: Buffer {
+                ptr,
+                len,
+                requested_len: req,
+                capacity: cap,
+                allocator: self.allocator,
+            },
+            actual_len: self.actual as usize,
+            status: self.status(),
+        }
+    }
+}
+
+impl Drop for TransferData {
+    fn drop(&mut self) {
+        if !self.ptr.is_null() {
+            unsafe {
+                drop(Buffer {
+                    ptr: self.ptr,
+                    len: if Direction::from_address(self.endpoint) == Direction::In {
+                        self.actual
+                    } else {
+                        self.length
+                    },
+                    requested_len: self.requested,
+                    capacity: self.capacity,
+                    allocator: self.allocator,
+                });
+            }
+        }
+    }
+}
