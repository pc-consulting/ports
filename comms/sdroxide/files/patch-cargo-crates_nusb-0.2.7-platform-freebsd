+pub struct Interface {
+    pub(crate) device: Arc<Device>,
+    pub(crate) interface_number: u8,
+    alt_setting: std::sync::Mutex<u8>,
+}
+
+impl Interface {
+    pub fn set_alt_setting(self:Arc<Self>, alt:u8)->impl MaybeFuture<Output=Result<(),Error>>{
+        let rc=unsafe{libusb_set_interface_alt_setting(self.device.inner.handle,self.interface_number as i32,alt as i32)};
+        if rc==SUCCESS {*self.alt_setting.lock().unwrap()=alt; Ready(Ok(()))} else {Ready(Err(error(rc,"failed to set alternate setting")))}
+    }
+    pub fn get_alt_setting(&self)->u8{*self.alt_setting.lock().unwrap()}
+    pub fn control_in(&self,data:ControlIn,timeout:Duration)->impl MaybeFuture<Output=Result<Vec<u8>,TransferError>>{self.device.clone().control_in(data,timeout)}
+    pub fn control_out(&self,data:ControlOut,timeout:Duration)->impl MaybeFuture<Output=Result<(),TransferError>>{self.device.clone().control_out(data,timeout)}
+    pub fn interface_number(&self)->u8{self.interface_number}
+    pub fn endpoint(self:&Arc<Self>, descriptor:EndpointDescriptor)->Result<Endpoint,Error>{
+        Ok(Endpoint{inner:Arc::new(EndpointInner{interface:self.clone(),address:descriptor.address(),ep_type:descriptor.transfer_type(),notify:Arc::new(Notify::new())}),max_packet_size:descriptor.max_packet_size(),pending:VecDeque::new()})
+    }
+    pub fn release(self:Arc<Self>)->impl MaybeFuture<Output=Result<(),Error>>{
+        if Arc::strong_count(&self)==1 {
+            let rc=unsafe{libusb_release_interface(self.device.inner.handle,self.interface_number as i32)};
+            Ready(if rc==SUCCESS{Ok(())}else{Err(error(rc,"failed to release interface"))})
+        } else {Ready(Err(Error::new(ErrorKind::Busy,"interface is still in use")))}
+    }
+}
