+fn collect_config_descriptors(
+    handle: *mut libusb_device_handle,
+    count: u8,
+) -> Vec<Vec<u8>> {
+    let mut configs = Vec::new();
+    for idx in 0..count {
+        let mut head = [0u8; 9];
+        let got = unsafe { libusb_get_descriptor(handle, 2, idx, head.as_mut_ptr(), 9) };
+        if got < 9 {
+            continue;
+        }
+        let total = u16::from_le_bytes([head[2], head[3]]) as usize;
+        if !(9..=65535).contains(&total) {
+            continue;
+        }
+        let mut raw = vec![0u8; total];
+        let got = unsafe { libusb_get_descriptor(handle, 2, idx, raw.as_mut_ptr(), total as i32) };
+        if got > 0 {
+            raw.truncate(got as usize);
+            configs.push(raw);
+        }
+    }
+    configs
+}
+
+fn string_descriptor(
+    handle: *mut libusb_device_handle,
+    index: u8,
+    buf: &mut [u8],
+) -> Option<String> {
+    let n = unsafe {
+        libusb_get_string_descriptor_ascii(handle, index, buf.as_mut_ptr(), buf.len() as i32)
+    };
+    (n > 0).then(|| String::from_utf8_lossy(&buf[..n as usize]).into_owned())
+}
+
+fn parse_interfaces(raw: &[u8], out: &mut Vec<InterfaceInfo>) {
+    let mut pos = 0usize;
+    while pos + 2 <= raw.len() {
+        let len = raw[pos] as usize;
+        let ty = raw[pos + 1];
+        if len < 2 || pos + len > raw.len() {
+            break;
+        }
+        if ty == 4 && len >= 9 {
+            out.push(InterfaceInfo {
+                interface_number: raw[pos + 2],
+                class: raw[pos + 5],
+                subclass: raw[pos + 6],
+                protocol: raw[pos + 7],
+                interface_string: None,
+            });
+        }
+        pos += len;
+    }
+}
