+    pub fn control_in(
+        self: Arc<Self>, data: ControlIn, timeout: Duration,
+    ) -> impl MaybeFuture<Output = Result<Vec<u8>, TransferError>> {
+        let handle = self.inner.handle;
+        let t = TransferData::new_control_in(data);
+        TransferFuture::new(t, move |mut idle| {
+            let raw = idle.as_ptr();
+            let pending = idle.pre_submit();
+            std::thread::spawn(move || {
+                let td = unsafe { &mut *raw };
+                let setup = unsafe { std::slice::from_raw_parts(td.ptr, 8) };
+                let rc = unsafe {
+                    libusb_control_transfer(handle, setup[0], setup[1],
+                        u16::from_le_bytes([setup[2], setup[3]]),
+                        u16::from_le_bytes([setup[4], setup[5]]),
+                        td.ptr.add(8), u16::from_le_bytes([setup[6], setup[7]]),
+                        timeout.as_millis().min(u32::MAX as u128) as u32)
+                };
+                td.actual = if rc >= 0 { rc as u32 } else { 0 };
+                td.status = if rc >= 0 { 0 } else { rc };
+                unsafe { crate::transfer::internal::notify_completion(raw) };
+            });
+            pending
+        }).map(move |mut t| { let r=t.status(); if r.is_ok() { Ok(t.control_data().to_vec()) } else { Err(r.unwrap_err()) } })
+    }
