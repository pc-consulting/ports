+fn open_device(info:&DeviceInfo)->Result<Arc<Device>,Error>{
+    let ctx=context()?;
+    let mut list=ptr::null_mut();
+    let n=unsafe{libusb_get_device_list(ctx,&mut list)};
+    if n<0 {return Err(error(n as i32,"failed to enumerate USB devices"));}
+    let mut found=ptr::null_mut();
+    for i in 0..n as usize {
+        let d=unsafe{*list.add(i)};
+        if unsafe{libusb_get_bus_number(d)}==info.busnum && unsafe{libusb_get_device_address(d)}==info.device_address {
+            found=unsafe{libusb_ref_device(d)}; break;
+        }
+    }
+    unsafe{libusb_free_device_list(list,1)};
+    if found.is_null(){return Err(Error::new(ErrorKind::Disconnected,"device disappeared"));}
+    let mut handle=ptr::null_mut();
+    let rc=unsafe{libusb_open(found,&mut handle)};
+    unsafe{libusb_unref_device(found)};
+    if rc!=SUCCESS{return Err(error(rc,"failed to open USB device"));}
+
+    let mut desc=LibusbDeviceDescriptor::default();
+    let dev=unsafe{libusb_get_device(handle)};
+    let rc=unsafe{libusb_get_device_descriptor(dev,&mut desc)};
+    if rc!=SUCCESS {unsafe{libusb_close(handle)};return Err(error(rc,"failed to read device descriptor"));}
+
+    let mut descriptor=[0u8;18];
+    descriptor[0]=18; descriptor[1]=1;
+    descriptor[2..4].copy_from_slice(&desc.bcd_usb.to_le_bytes());
+    descriptor[4]=desc.b_device_class; descriptor[5]=desc.b_device_sub_class; descriptor[6]=desc.b_device_protocol;
+    descriptor[7]=desc.b_max_packet_size0; descriptor[8..10].copy_from_slice(&desc.id_vendor.to_le_bytes());
+    descriptor[10..12].copy_from_slice(&desc.id_product.to_le_bytes()); descriptor[12..14].copy_from_slice(&desc.bcd_device.to_le_bytes());
+    descriptor[14]=desc.i_manufacturer; descriptor[15]=desc.i_product; descriptor[16]=desc.i_serial_number; descriptor[17]=desc.b_num_configurations;
+
+    let configs = collect_config_descriptors(handle, desc.b_num_configurations)
+        .into_iter().flatten().collect();
+    Ok(Arc::new(Device{inner:Arc::new(DeviceInner{handle,descriptor,configs})}))
+}
