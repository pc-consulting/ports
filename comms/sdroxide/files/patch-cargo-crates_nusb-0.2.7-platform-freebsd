+fn context() -> Result<*mut libusb_context, Error> {
+    static CTX: std::sync::OnceLock<Result<usize, i32>> = std::sync::OnceLock::new();
+    let r = CTX.get_or_init(|| {
+        let mut ctx = ptr::null_mut();
+        let rc = unsafe { libusb_init(&mut ctx) };
+        if rc == SUCCESS { Ok(ctx as usize) } else { Err(rc) }
+    });
+    match r {
+        Ok(p) => Ok(*p as *mut libusb_context),
+        Err(rc) => Err(Error::new_os(ErrorKind::Other, "failed to initialize FreeBSD libusb", *rc)),
+    }
+}
+
+fn error(rc: i32, what: &'static str) -> Error {
+    let kind = match rc {
+        ERROR_NO_DEVICE => ErrorKind::Disconnected,
+        ERROR_BUSY => ErrorKind::Busy,
+        ERROR_ACCESS => ErrorKind::PermissionDenied,
+        ERROR_NOT_FOUND => ErrorKind::NotFound,
+        ERROR_NOT_SUPPORTED => ErrorKind::Unsupported,
+        _ => ErrorKind::Other,
+    };
+    Error {
+        kind,
+        code: NonZeroU32::new(rc.unsigned_abs()),
+        message: what,
+    }
+}
+
+fn transfer_error(rc: i32) -> TransferError {
+    match rc {
+        ERROR_TIMEOUT | ERROR_INTERRUPTED => TransferError::Cancelled,
+        ERROR_PIPE => TransferError::Stall,
+        ERROR_NO_DEVICE => TransferError::Disconnected,
+        ERROR_INVALID_PARAM => TransferError::InvalidArgument,
+        ERROR_OVERFLOW | ERROR_IO => TransferError::Fault,
+        x => TransferError::Unknown(x.unsigned_abs()),
+    }
+}
