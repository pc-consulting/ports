+impl MidiInput {
+    pub fn new(_client_name: &str) -> Result<Self, InitError> {
+        Ok(Self {
+            ignore_flags: Ignore::None,
+        })
+    }
+
+    pub fn ignore(&mut self, flags: Ignore) {
+        self.ignore_flags = flags;
+    }
+
+    pub(crate) fn ports_internal(&self) -> Vec<crate::common::MidiInputPort> {
+        enumerate_ports()
+            .into_iter()
+            .map(|id| crate::common::MidiInputPort {
+                imp: MidiInputPort { id },
+            })
+            .collect()
+    }
+
+    pub fn port_count(&self) -> usize {
+        enumerate_ports().len()
+    }
+
+    pub fn port_name(&self, port: &MidiInputPort) -> Result<String, PortInfoError> {
+        Ok(port.id.clone())
+    }
+
+    pub fn connect<F, T: Send>(
+        self,
+        port: &MidiInputPort,
+        port_name: &str,
+        callback: F,
+        data: T,
+    ) -> Result<MidiInputConnection<T>, ConnectError<Self>>
+    where
+        F: FnMut(u64, &[u8], &mut T) + Send + 'static,
+    {
+        let trigger_fds = match init_trigger() {
+            Ok(fds) => fds,
+            Err(()) => {
+                return Err(ConnectError::other(
+                    "could not create communication pipe for FreeBSD MIDI handler",
+                    self,
+                ));
+            }
+        };
+
+        let handle = match open_mio(&port.id, MIO_IN, true) {
+            Some(handle) => handle,
+            None => {
+                return Err(ConnectError::new(ConnectErrorKind::InvalidPort, self));
+            }
+        };
+
+        let raw_handle = handle.0 as usize;
+        let trigger_rx = trigger_fds.0;
+        let ignore_flags = self.ignore_flags;
+
+        /*
+         * The raw pointer itself is deliberately converted to usize before
+         * entering the spawned closure.  Raw pointers do not implement Send,
+         * whereas the handle is exclusively owned by the input thread.
+         */
+        let thread_name = format!("midir FreeBSD input handler (port '{port_name}')");
+        let thread = match Builder::new()
+            .name(thread_name)
+            .spawn(move || {
+                let handle = raw_handle as *mut MioHdl;
+                let mut user_data = data;
+                let mut callback: Box<CallbackFn<T>> = Box::new(callback);
+                let mut decoder = MidiDecoder::new(ignore_flags);
+                let started = Instant::now();
+                let mut input_buffer = [0u8; 4096];
+                let mut poll_fds = Vec::<pollfd>::new();
+
+                loop {
+                    let nfds = unsafe { mio_nfds(handle) };
+                    if nfds <= 0 {
+                        break;
+                    }
+
+                    poll_fds.resize(
+                        nfds as usize + 1,
+                        pollfd {
+                            fd: -1,
+                            events: 0,
+                            revents: 0,
+                        },
+                    );
+
+                    poll_fds[0] = pollfd {
+                        fd: trigger_rx.get(),
+                        events: libc::POLLIN,
+                        revents: 0,
+                    };
+
+                    let mio_nfds = unsafe {
+                        mio_pollfd(
+                            handle,
+                            poll_fds[1..].as_mut_ptr(),
+                            libc::POLLIN,
+                        )
+                    };
+
+                    if mio_nfds <= 0 {
+                        break;
+                    }
+
+                    let poll_result = unsafe {
+                        libc::poll(
+                            poll_fds.as_mut_ptr(),
+                            poll_fds.len() as libc::nfds_t,
+                            -1,
+                        )
+                    };
+
+                    if poll_result < 0 {
+                        if std::io::Error::last_os_error().raw_os_error()
+                            == Some(libc::EINTR)
+                        {
+                            continue;
+                        }
+                        break;
+                    }
+
+                    if poll_fds[0].revents != 0 {
+                        break;
+                    }
+
+                    let revents = unsafe {
+                        mio_revents(handle, poll_fds[1..].as_mut_ptr())
+                    };
+
+                    if revents & libc::POLLIN == 0 {
+                        if revents & (libc::POLLERR | libc::POLLHUP | libc::POLLNVAL) != 0 {
+                            break;
+                        }
+                        continue;
+                    }
+
+                    let n = unsafe {
+                        mio_read(
+                            handle,
+                            input_buffer.as_mut_ptr() as *mut c_void,
+                            input_buffer.len(),
+                        )
+                    };
+
+                    if n == 0 {
+                        if unsafe { mio_eof(handle) } != 0 {
+                            break;
+                        }
+                        continue;
+                    }
+
+                    for &byte in &input_buffer[..n] {
+                        if let Some(message) = decoder.push(byte) {
+                            let timestamp = started.elapsed().as_micros() as u64;
+                            callback(timestamp, &message, &mut user_data);
+                        }
+                    }
+                }
+
+                /*
+                 * The handle is closed here, in the same thread which used
+                 * it.  This also guarantees that the sndio calls on a handle
+                 * remain serialized.
+                 */
+                unsafe {
+                    mio_close(handle);
+                }
+
+                user_data
+            }) {
+            Ok(thread) => thread,
+            Err(_) => {
+                drop(handle);
+                return Err(ConnectError::other(
+                    "could not start FreeBSD MIDI input handler thread",
+                    self,
+                ));
+            }
+        };
+
+        /*
+         * Ownership of the sndio handle was transferred into the thread as a
+         * raw pointer.  Prevent the temporary Rust owner from closing it.
+         */
+        mem::forget(handle);
+        mem::forget(trigger_fds.0);
+
+        Ok(MidiInputConnection {
+            thread: Some(thread),
+            trigger_send_fd: Some(trigger_fds.1),
+            ignore_flags,
+        })
+    }
+
+    pub fn create_virtual<F, T: Send>(
+        self,
+        _port_name: &str,
+        _callback: F,
+        _data: T,
+    ) -> Result<MidiInputConnection<T>, ConnectError<Self>>
+    where
+        F: FnMut(u64, &[u8], &mut T) + Send + 'static,
+    {
+        Err(ConnectError::other(
+            "FreeBSD sndio does not provide midir virtual-port creation",
+            self,
+        ))
+    }
+}
