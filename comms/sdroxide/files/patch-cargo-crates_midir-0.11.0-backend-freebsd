+#[repr(C)]
+struct MioHdl {
+    _private: [u8; 0],
+}
+
+unsafe extern "C" {
+    fn mio_open(name: *const c_char, mode: c_uint, nbio_flag: c_int) -> *mut MioHdl;
+    fn mio_close(hdl: *mut MioHdl);
+    fn mio_read(hdl: *mut MioHdl, addr: *mut c_void, nbytes: usize) -> usize;
+    fn mio_write(hdl: *mut MioHdl, addr: *const c_void, nbytes: usize) -> usize;
+    fn mio_nfds(hdl: *mut MioHdl) -> c_int;
+    fn mio_pollfd(hdl: *mut MioHdl, pfd: *mut pollfd, events: c_int) -> c_int;
+    fn mio_revents(hdl: *mut MioHdl, pfd: *mut pollfd) -> c_int;
+    fn mio_eof(hdl: *mut MioHdl) -> c_int;
+}
+
+struct MioHandle(*mut MioHdl);
+
+/*
+ * A MioHandle is only ever accessed by one thread at a time.  In particular,
+ * input handles are opened before spawning the input thread and subsequently
+ * owned exclusively by that thread.  Output handles can be moved into the
+ * callback thread by midir clients.
+ */
+unsafe impl Send for MioHandle {}
+
+impl Drop for MioHandle {
+    fn drop(&mut self) {
+        if !self.0.is_null() {
+            unsafe {
+                mio_close(self.0);
+            }
+        }
+    }
+}
+
+#[repr(transparent)]
+struct PipeFd(c_int);
+
+impl PipeFd {
+    fn get(&self) -> c_int {
+        self.0
+    }
+}
+
+impl Drop for PipeFd {
+    fn drop(&mut self) {
+        unsafe {
+            libc::close(self.0);
+        }
+    }
+}
+
+fn open_mio(port: &str, mode: c_uint, nonblocking: bool) -> Option<MioHandle> {
+    let name = CString::new(port).ok()?;
+    let hdl = unsafe { mio_open(name.as_ptr(), mode, nonblocking as c_int) };
+    if hdl.is_null() {
+        None
+    } else {
+        Some(MioHandle(hdl))
+    }
+}
+
+fn enumerate_ports() -> Vec<String> {
+    let mut ports = Vec::new();
+
+    /*
+     * sndiod's first MIDI thru endpoint is a useful software MIDI endpoint.
+     * Only advertise it when it can actually be opened.
+     */
+    if let Some(hdl) = open_mio("midithru/0", MIO_IN, true) {
+        drop(hdl);
+        ports.push("midithru/0".to_string());
+    }
+
+    if let Ok(entries) = fs::read_dir("/dev") {
+        let mut rmidi = entries
+            .filter_map(Result::ok)
+            .filter_map(|entry| {
+                let name = entry.file_name();
+                let name = name.to_str()?;
+                if !name.starts_with("rmidi") {
+                    return None;
+                }
+                let suffix = &name[5..];
+                if suffix.is_empty() || !suffix.bytes().all(|b| b.is_ascii_digit()) {
+                    return None;
+                }
+                Some(name.to_string())
+            })
+            .collect::<Vec<_>>();
+
+        rmidi.sort();
+
+        for name in rmidi {
+            let path = format!("/dev/{name}");
+            if Path::new(&path).exists() {
+                ports.push(format!("rmidi/{0}", &name[5..]));
+            }
+        }
+    }
+
+    ports
+}
