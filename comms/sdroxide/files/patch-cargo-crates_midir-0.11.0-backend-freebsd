+impl<T> MidiInputConnection<T> {
+    pub fn close(mut self) -> (MidiInput, T) {
+        let data = self.close_internal();
+        (
+            MidiInput {
+                ignore_flags: self.ignore_flags,
+            },
+            data,
+        )
+    }
+
+    fn close_internal(&mut self) -> T {
+        if let Some(fd) = self.trigger_send_fd.as_ref() {
+            let byte = [0u8; 1];
+            unsafe {
+                libc::write(
+                    fd.get(),
+                    byte.as_ptr() as *const c_void,
+                    byte.len(),
+                );
+            }
+        }
+
+        self.trigger_send_fd.take();
+
+        let thread = self.thread.take().expect("MIDI input thread already stopped");
+        match thread.join() {
+            Ok(data) => data,
+            Err(err) => {
+                if let Some(message) = err.downcast_ref::<&'static str>() {
+                    panic!("FreeBSD MIDI input thread panicked: {message}");
+                }
+                panic!("FreeBSD MIDI input thread panicked");
+            }
+        }
+    }
+}
+
+impl<T> Drop for MidiInputConnection<T> {
+    fn drop(&mut self) {
+        if self.thread.is_some() {
+            let _ = self.close_internal();
+        }
+    }
+}
