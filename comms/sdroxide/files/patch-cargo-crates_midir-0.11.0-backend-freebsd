+impl MidiOutputConnection {
+    pub fn close(mut self) -> MidiOutput {
+        self.handle.take();
+        MidiOutput
+    }
+
+    pub fn send(&mut self, message: &[u8]) -> Result<(), SendError> {
+        if message.is_empty() {
+            return Ok(());
+        }
+
+        let handle = match self.handle.as_ref() {
+            Some(handle) => handle.0,
+            None => {
+                return Err(SendError::Other(
+                    "FreeBSD MIDI output connection is closed",
+                ));
+            }
+        };
+
+        let mut offset = 0;
+        while offset < message.len() {
+            let n = unsafe {
+                mio_write(
+                    handle,
+                    message[offset..].as_ptr() as *const c_void,
+                    message.len() - offset,
+                )
+            };
+
+            if n == 0 {
+                return Err(SendError::Other(
+                    "could not write MIDI data through sndio",
+                ));
+            }
+
+            offset += n;
+        }
+
+        Ok(())
+    }
+}
+
+impl Drop for MidiOutputConnection {
+    fn drop(&mut self) {
+        self.handle.take();
+    }
+}
+
+fn init_trigger() -> Result<(PipeFd, PipeFd), ()> {
+    let mut fds = [-1, -1];
+
+    if unsafe { libc::pipe(fds.as_mut_ptr()) } == -1 {
+        return Err(());
+    }
+
+    Ok((PipeFd(fds[0]), PipeFd(fds[1])))
+}
