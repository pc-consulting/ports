+struct MidiDecoder {
+    ignore: Ignore,
+    running_status: Option<u8>,
+    status: Option<u8>,
+    data: Vec<u8>,
+    needed: usize,
+    sysex: Option<Vec<u8>>,
+    sysex_ignored: bool,
+}
+
+impl MidiDecoder {
+    fn new(ignore: Ignore) -> Self {
+        Self {
+            ignore,
+            running_status: None,
+            status: None,
+            data: Vec::with_capacity(3),
+            needed: 0,
+            sysex: None,
+            sysex_ignored: false,
+        }
+    }
+
+    fn push(&mut self, byte: u8) -> Option<Vec<u8>> {
+        /*
+         * MIDI realtime messages may occur between any two bytes, including
+         * inside SysEx.  They therefore have priority over all other parsing.
+         */
+        if byte >= 0xF8 {
+            if (byte == 0xF8 || byte == 0xF9)
+                && self.ignore.contains(Ignore::Time)
+            {
+                return None;
+            }
+
+            if byte == 0xFE && self.ignore.contains(Ignore::ActiveSense) {
+                return None;
+            }
+
+            return Some(vec![byte]);
+        }
+
+        if let Some(sysex) = self.sysex.as_mut() {
+            if byte == 0xF7 {
+                sysex.push(byte);
+                let result = if self.sysex_ignored {
+                    None
+                } else {
+                    Some(std::mem::take(sysex))
+                };
+                self.sysex = None;
+                self.sysex_ignored = false;
+                return result;
+            }
+
+            if byte & 0x80 != 0 {
+                /*
+                 * Malformed/incomplete SysEx.  Drop it and treat the new
+                 * status byte as a resynchronization point.
+                 */
+                self.sysex = None;
+                self.sysex_ignored = false;
+                self.running_status = None;
+            } else {
+                sysex.push(byte);
+                return None;
+            }
+        }
+
+        if byte & 0x80 != 0 {
+            match byte {
+                0xF0 => {
+                    self.status = None;
+                    self.data.clear();
+                    self.needed = 0;
+                    self.running_status = None;
+                    self.sysex = Some(vec![0xF0]);
+                    self.sysex_ignored = self.ignore.contains(Ignore::Sysex);
+                    return None;
+                }
+
+                0xF1 => {
+                    self.start_system_status(byte, 1);
+                    return None;
+                }
+
+                0xF2 => {
+                    self.start_system_status(byte, 2);
+                    return None;
+                }
+
+                0xF3 => {
+                    self.start_system_status(byte, 1);
+                    return None;
+                }
+
+                0xF6 | 0xF7 => {
+                    self.running_status = None;
+                    self.status = None;
+                    self.data.clear();
+                    self.needed = 0;
+                    return Some(vec![byte]);
+                }
+
+                0x80..=0xEF => {
+                    self.running_status = Some(byte);
+                    self.status = Some(byte);
+                    self.data.clear();
+                    self.needed = channel_data_len(byte);
+                    return None;
+                }
+
+                _ => {
+                    /*
+                     * 0xF4/0xF5 and other undefined system common bytes are
+                     * treated as standalone messages for resynchronization.
+                     */
+                    self.running_status = None;
+                    self.status = None;
+                    self.data.clear();
+                    self.needed = 0;
+                    return Some(vec![byte]);
+                }
+            }
+        }
+
+        /*
+         * A data byte with no explicit status uses MIDI running status.
+         */
+        if self.status.is_none() {
+            if let Some(status) = self.running_status {
+                self.status = Some(status);
+                self.needed = channel_data_len(status);
+                self.data.clear();
+            } else {
+                return None;
+            }
+        }
+
+        self.data.push(byte);
+
+        if self.data.len() < self.needed {
+            return None;
+        }
+
+        let status = self.status.take().unwrap();
+        let mut message = Vec::with_capacity(self.data.len() + 1);
+        message.push(status);
+        message.extend_from_slice(&self.data);
+        self.data.clear();
+        self.needed = 0;
+
+        if status < 0xF0 {
+            /*
+             * Channel-message running status survives the completed message.
+             */
+            self.running_status = Some(status);
+        } else {
+            self.running_status = None;
+        }
+
+        Some(message)
+    }
+
+    fn start_system_status(&mut self, status: u8, needed: usize) {
+        self.running_status = None;
+        self.status = Some(status);
+        self.data.clear();
+        self.needed = needed;
+    }
+}
+
+fn channel_data_len(status: u8) -> usize {
+    match status & 0xF0 {
+        0xC0 | 0xD0 => 1,
+        _ => 2,
+    }
+}
