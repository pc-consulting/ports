+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn decode(bytes: &[u8], ignore: Ignore) -> Vec<Vec<u8>> {
+        let mut decoder = MidiDecoder::new(ignore);
+        bytes
+            .iter()
+            .filter_map(|&byte| decoder.push(byte))
+            .collect()
+    }
+
+    #[test]
+    fn channel_message() {
+        assert_eq!(
+            decode(&[0x90, 0x40, 0x7f], Ignore::None),
+            vec![vec![0x90, 0x40, 0x7f]]
+        );
+    }
+
+    #[test]
+    fn running_status() {
+        assert_eq!(
+            decode(
+                &[0x90, 0x40, 0x7f, 0x41, 0x7e],
+                Ignore::None
+            ),
+            vec![
+                vec![0x90, 0x40, 0x7f],
+                vec![0x90, 0x41, 0x7e]
+            ]
+        );
+    }
+
+    #[test]
+    fn program_change_has_one_data_byte() {
+        assert_eq!(
+            decode(&[0xC0, 0x05], Ignore::None),
+            vec![vec![0xC0, 0x05]]
+        );
+    }
+
+    #[test]
+    fn sysex() {
+        assert_eq!(
+            decode(&[0xF0, 0x01, 0x02, 0x03, 0xF7], Ignore::None),
+            vec![vec![0xF0, 0x01, 0x02, 0x03, 0xF7]]
+        );
+    }
+
+    #[test]
+    fn realtime_inside_sysex() {
+        assert_eq!(
+            decode(
+                &[0xF0, 0x01, 0xF8, 0x02, 0xF7],
+                Ignore::None
+            ),
+            vec![
+                vec![0xF8],
+                vec![0xF0, 0x01, 0x02, 0xF7]
+            ]
+        );
+    }
+
+    #[test]
+    fn ignored_realtime_inside_sysex() {
+        assert_eq!(
+            decode(
+                &[0xF0, 0x01, 0xF8, 0x02, 0xF7],
+                Ignore::Time
+            ),
+            vec![vec![0xF0, 0x01, 0x02, 0xF7]]
+        );
+    }
+
+    #[test]
+    fn ignore_sysex() {
+        assert_eq!(
+            decode(
+                &[0xF0, 0x01, 0x02, 0xF7],
+                Ignore::Sysex
+            ),
+            Vec::<Vec<u8>>::new()
+        );
+    }
+
+    #[test]
+    fn ignore_active_sense() {
+        assert_eq!(
+            decode(&[0xFE, 0x90, 0x40, 0x7f], Ignore::ActiveSense),
+            vec![vec![0x90, 0x40, 0x7f]]
+        );
+    }
+}
